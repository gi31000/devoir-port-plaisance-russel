<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <title>Tableau de bord - Port de Plaisance Russell</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <nav>
    <a href="/dashboard">Tableau de bord</a> |
    <a href="/dashboard/catways">Catways</a> |
    <a href="/dashboard/reservations">Réservations</a> |
    <a href="/dashboard/users">Utilisateurs</a> |
    <a href="/api-docs">Documentation API</a> |
    <a href="/logout">Déconnexion</a>
  </nav>

  <h1>Tableau de bord</h1>
  <p>Connecté en tant que <strong><%= user.username %></strong> (<%= user.email %>)</p>
  <p>Date du jour : <%= today.toLocaleDateString('fr-FR') %></p>

  <h2>Réservations en cours</h2>
  <table border="1">
    <thead>
      <tr>
        <th>Catway</th>
        <th>Client</th>
        <th>Bateau</th>
        <th>Début</th>
        <th>Fin</th>
      </tr>
    </thead>
    <tbody>
      <% reservations.forEach(r => { %>
        <tr>
          <td><%= r.catwayNumber %></td>
          <td><%= r.clientName %></td>
          <td><%= r.boatName %></td>
          <td><%= r.startDate.toLocaleDateString('fr-FR') %></td>
          <td><%= r.endDate.toLocaleDateString('fr-FR') %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</body>
</html>